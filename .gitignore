# --- MultiMedAI: keep heavy/credentialed artifacts out of git ---
data/
weights/
venv/
.venv/
__pycache__/
*.py[cod]

# model / checkpoint files
*.ckpt
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# large media (committed samples live in outputs/ and are added with -f)
*.mp4
*.mov
*.zip
*.tar
*.tar.gz

# HF / torch caches if they land locally
.cache/
hf_cache/

# secrets / API keys — NEVER commit
.keys.json
.env
*.key
.gemini_key
.serpapi_key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.ipynb_checkpoints/

# allow small committed sample outputs
!outputs/
!outputs/**

# but NOT runtime-generated artifacts (test reports, generated imgs, request logs)
outputs/web/*.png
outputs/web/*.pdf
outputs/web/*.log
outputs/web/credentials/

# local agent/session state
.claude/
